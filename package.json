{
  "name": "decky-audiobookshelf",
  "version": "0.1.0-alpha.3",
  "description": "Controller-native Audiobookshelf playback for Decky Loader",
  "type": "module",
  "scripts": {
    "build": "\"$npm_node_execpath\" ./scripts/build.mjs",
    "package:plugin": "PYTHONDONTWRITEBYTECODE=1 python3 ./scripts/package_plugin.py",
    "watch": "\"$npm_node_execpath\" ./node_modules/rollup/dist/bin/rollup -c -w",
    "typecheck": "\"$npm_node_execpath\" ./node_modules/typescript/bin/tsc --noEmit",
    "test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/decky-audiobookshelf.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "audiobookshelf",
    "steam-deck",
    "deck"
  ],
  "author": "Allen",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
